<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PharmaCare Pro</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-teal">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">PharmaCare Pro</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Sales" asp-action="Index">Bán thuốc (POS)</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Medicines" asp-action="Index">Thuốc</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Batches" asp-action="Index">Lô &amp; Tồn kho</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Receipts" asp-action="Index">Nhập hàng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Prescriptions" asp-action="Index">Đơn thuốc</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Returns" asp-action="Index">Trả thuốc</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Báo cáo</a></li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main class="container-fluid py-3">
        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
        @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
        @RenderBody()
    </main>
    <footer class="text-center text-muted py-3 small">PharmaCare Pro — Nhóm 2 HUIT · Quản lý nhà thuốc theo lô &amp; FEFO</footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
