@model List<Medicine>
@{ ViewData["Title"] = "Danh mục thuốc"; var today = (DateOnly)ViewBag.Today; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Danh mục thuốc</h3>
    @if (User.IsInRole("Admin") || User.IsInRole("Pharmacist"))
    { <a class="btn btn-primary" asp-action="Create">+ Thêm thuốc</a> }
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Tìm theo tên, mã hoặc hoạt chất..." /></div>
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Tìm</button></div>
</form>
<table class="table table-striped align-middle">
    <thead><tr><th>Mã</th><th>Tên thuốc</th><th>Hoạt chất</th><th>Dạng</th><th>Hàm lượng</th><th>Giá bán</th><th>Tồn bán được</th><th>Kê đơn</th><th></th></tr></thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.Code</td><td class="fw-semibold">@m.Name</td>
            <td>@string.Join(", ", m.Ingredients.Select(i => i.ActiveIngredient!.Name))</td>
            <td>@m.DosageForm?.Name</td><td>@m.Strength</td>
            <td>@m.SalePrice.ToString("N0") ₫/@m.Unit</td>
            <td>@PharmaCare.Core.Services.FefoAllocator.SellableStock(m.Batches, m.Id, today)</td>
            <td>@(m.RequiresPrescription ? "Có" : "Không")</td>
            <td>@if (User.IsInRole("Admin") || User.IsInRole("Pharmacist"))
                { <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.Id">Sửa</a> }</td>
        </tr>
    }
    </tbody>
</table>
