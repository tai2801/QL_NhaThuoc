@model List<Prescription>
@{ ViewData["Title"] = "Đơn thuốc"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Đơn thuốc kê đơn</h3>
    @if (User.IsInRole("Admin") || User.IsInRole("Pharmacist"))
    { <a class="btn btn-primary" asp-action="Create">+ Nhập đơn thuốc</a> }
</div>
<table class="table table-striped align-middle">
    <thead><tr><th>Mã đơn</th><th>Bệnh nhân</th><th>Bác sĩ kê</th><th>Đơn vị kê</th><th>Chẩn đoán</th><th>Ngày kê</th><th>Hiệu lực đến</th><th>Trạng thái</th><th>Chi tiết thuốc</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td class="fw-semibold">@p.Code</td><td>@p.Customer?.FullName</td>
            <td>@p.DoctorName</td><td>@p.IssuingUnit</td><td>@p.Diagnosis</td>
            <td>@p.IssuedDate.ToString("dd/MM/yyyy")</td>
            <td>@p.ValidUntil?.ToString("dd/MM/yyyy")</td><td>@p.Status</td>
            <td class="small">@string.Join("; ", p.Lines.Select(l => $"{l.Medicine?.Name} ×{l.QuantityPrescribed} ({l.DosageInstruction})"))</td>
        </tr>
    }
    </tbody>
</table>
